# Copy this file to backend/.env and fill in what you need.
# The app runs with NO keys at all: demo AI engine + simulated tracker, both clearly labelled in the UI.

# ---- Sign-in -----------------------------------------------------------------------------------
# Password for the seeded demo accounts (Admin, Anshul, Rahul, Priya, Karan). Change it for any shared deployment.
DEMO_PASSWORD=demo1234

# ---- AI engine ---------------------------------------------------------------------------------
# demo   = deterministic rules engine (no network, labelled "Demo mode" in the UI)
# openai = any OpenAI-compatible chat-completions API (Gemini, OpenAI, Groq, OpenRouter...)
AI_PROVIDER=demo
# Gemini (free tier available at https://aistudio.google.com/apikey):
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.0-flash
AI_API_KEY=
# OpenAI instead:  AI_BASE_URL=https://api.openai.com/v1/   AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60

# ---- Task tracker ------------------------------------------------------------------------------
# demo   = simulated tracker inside the app (never claims an external task exists)
# github = real GitHub Issues
TRACKER_PROVIDER=demo
# Fine-grained token with "Issues: Read and write" on ONE repository:
GITHUB_TOKEN=
# owner/repository, e.g. ravinder/atlas-tasks
GITHUB_REPO=
# Optional: map names spoken in meetings to GitHub logins (must be repo collaborators to be assigned)
GITHUB_ASSIGNEES=

# ---- Server ------------------------------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=2097152
SCHEDULER_ENABLED=true
# DATABASE_URL=sqlite:///C:/path/to/app.db   (default: backend/data/app.db)
